# Plane credentials and notifier flags for the Machinist factory.
#
# Copy this file to /etc/machinist/plane.env, fill in the real values and keep
# it root-owned and mode 0600. The filled file is never committed; only this
# placeholder template lives in git.
#
# Referenced by: machinist-control.service, machinist-fail-notify.service.

PLANE_URL=https://plane.example.com
PLANE_WORKSPACE=
PLANE_API_KEY=changeme