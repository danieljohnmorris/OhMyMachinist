# Non-secret instance and tooling values for the Machinist factory.
#
# Copy this file to /etc/machinist/machinist.env and edit it for this host. It
# carries no credentials, but it is still an instance file outside git; only
# this placeholder template lives in the repository.
#
# Referenced by: machinist-control.service, machinist-fail-notify.service,
# machinist-worker.service, machinist-worker@.service.

# PATH is an instance value: when gh, go, node or omp come from a version
# manager (mise shims, ~/.local/bin), add those directories here. Without it
# the control plane loses gh and the jobs lose their toolchain; systemd's
# default PATH only covers /usr, ~/bin and ~/.local/bin.
# PATH=/home/machinist/.local/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin

# omp executor and the alias of the model it should use.
MACHINIST_OMP_BIN=/home/machinist/.local/bin/omp
MACHINIST_OMP_MODEL=changeme

# Where install-review-skills.sh puts the pinned trufflehog binary.
MACHINIST_TOOL_DIR=/usr/local/bin

# Executor used for the built-in PR review; empty means the review uses the
# omp-glm wrapper sitting next to deliver-pr.py.
MACHINIST_REVIEW_EXECUTOR=

# GitHub owners the delivery step may push to (comma-separated).
MACHINIST_ALLOWED_OWNERS=changeme