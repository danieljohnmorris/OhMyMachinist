#!/usr/bin/env bash
# Machinist "codex-glm-pr" executor wrapper (trusted, root-owned; agents cannot edit).
# Named "codex" so Machinist v0.4.0 still parses Codex --json output.
# 1. Runs the real Codex CLI with the given args (sandbox stays workspace-write).
# 2. If Codex succeeded, runs deliver-pr.py OUTSIDE the sandbox: branch, commit,
#    push over SSH, open PR with gh. The model never gets network/.git access.
# 3. (2026-10-16, MACH-25) Failures are handled by the control plane's
#    self-healing pass; the wrapper no longer runs fail.py.
set -uo pipefail
REAL_CODEX="${MACHINIST_REAL_CODEX:-$HOME/.local/share/mise/shims/codex}"
HERE="$(dirname "$(readlink -f "$0")")"
repo="$(pwd)"
brief="$(mktemp)"
trap 'rm -f "$brief"' EXIT

fail() {  # fail <rc> <stage>
  echo "codex-glm-pr: failed at stage $2 with exit $1" >&2
  exit "$1"
}
trap 'echo "codex-glm-pr: killed by signal (timeout/stop)" >&2; fail 143 killed' TERM INT

if [ -n "$(git -C "$repo" status --porcelain 2>/dev/null)" ]; then
  echo "codex-glm-pr: refusing to start: $repo has uncommitted changes (stash or commit them first)" >&2
  fail 4 preflight
fi
start_branch="$(git -C "$repo" rev-parse --abbrev-ref HEAD)"

cat > "$brief"
"$REAL_CODEX" "$@" < "$brief"
rc=$?
if [ $rc -ne 0 ]; then
  echo "codex-glm-pr: codex exited $rc; skipping PR delivery" >&2
  fail $rc codex
fi
/usr/bin/python3 "$HERE/deliver-pr.py" --repo "$repo" --brief "$brief" --start-branch "$start_branch" 1>&2
rc=$?
[ $rc -ne 0 ] && fail $rc deliver-pr
exit 0
