#!/usr/bin/env bash
# Machinist "omp-glm-pr" executor wrapper (trusted, root-owned; agents cannot edit). 2026-10-11, copied from ./codex.
# Coding step runs ./omp-glm medium (local GLM Flash, bwrap sandbox) instead of Codex.
# 1. Runs omp-glm medium on the brief (bwrap: repo writable, .git read-only, no keys).
# 2. If omp succeeded, runs deliver-pr.py OUTSIDE the sandbox: branch, commit,
#    push over SSH, open PR with gh. The model never gets .git write or push keys.
# 3. (2026-10-10) On ANY failure (preflight / omp / deliver-pr / killed) runs
#    fail.py hook -> ~/.machinist/alerts/inbox/<job>.json; machinist-fail-notify.path
#    then comments on the Plane ticket and hands it to Factory Alerts (alerts/pending/).
#
# MACH-42: the coding omp run defaults to MACHINIST_OMP_MODE=json so the worker
# streams every message, thinking block, tool call and result into the run
# transcript. The variable is set for that one command only, so deliver-pr.py and
# the built-in review keep the wrapper's text default.
set -uo pipefail
OMP_RUN="$(dirname "$(readlink -f "$0")")/omp-glm"
HERE="$(dirname "$(readlink -f "$0")")"
repo="$(pwd)"
brief="$(mktemp)"; errlog="$(mktemp)"
trap 'rm -f "$brief" "$errlog"' EXIT
exec 3>&2
exec 2> >(tee -a "$errlog" >&3)

fail() {  # fail <rc> <stage>
  sleep 0.3
  /usr/bin/python3 "$HERE/fail.py" hook --rc "$1" --stage "$2" --stderr-file "$errlog" --brief "$brief" 2>&3 || true
  exit "$1"
}
trap 'echo "omp-glm-pr: killed by signal (timeout/stop)" >&2; fail 143 killed' TERM INT

if [ -n "$(git -C "$repo" status --porcelain 2>/dev/null)" ]; then
  echo "omp-glm-pr: refusing to start: $repo has uncommitted changes (stash or commit them first)" >&2
  fail 4 preflight
fi
start_branch="$(git -C "$repo" rev-parse --abbrev-ref HEAD)"

cat > "$brief"
MACHINIST_OMP_MODE="${MACHINIST_OMP_MODE:-json}" "$OMP_RUN" medium < "$brief"
rc=$?
if [ $rc -ne 0 ]; then
  echo "omp-glm-pr: omp exited $rc; skipping PR delivery" >&2
  fail $rc omp
fi
/usr/bin/python3 "$HERE/deliver-pr.py" --repo "$repo" --brief "$brief" --start-branch "$start_branch" 1>&2
rc=$?
[ $rc -ne 0 ] && fail $rc deliver-pr
exit 0