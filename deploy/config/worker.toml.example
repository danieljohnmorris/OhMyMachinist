# Machinist worker configuration template.
#
# The installer copies this file to /etc/machinist/worker.toml (and, for each
# lane unit, /etc/machinist/worker-<lane>.toml) only when the file does not
# exist; it never overwrites an existing worker config, the local overlay or
# the env files. Instance values belong in /etc/machinist/worker.local.toml,
# merged on top of this file at load time (base first, overlay second, the
# overlay wins). Secrets never belong here: the control-plane token is read
# from token_file and Plane/GitHub tokens come from the systemd
# EnvironmentFile files under /etc/machinist/.

# Optional; defaults to the machine hostname.
# name = "lane"
data_directory = "~/.machinist/worker"

[control_plane]
url = "http://127.0.0.1:7331"
token_file = "~/.machinist/server/worker.token"

# Per-job memory caps (MACH-62). Each job runs in its own cgroup scope, so a
# runaway job is OOM-killed instead of the worker. Values use systemd size
# syntax (K/M/G/T, binary: 1G = 1024^3) or plain bytes; "max", "none", "0"
# disable a limit. Empty keys fall back to the defaults shown and high must not
# exceed max. These caps are per job; the worker-level backstop lives in
# deploy/systemd/machinist-worker.service.d/memory.conf (OOMPolicy=continue,
# MemoryMax=12G, Delegate=yes).
[memory]
high = "8G"
max = "10G"
swap_max = "2G"

# Executors read a prompt on stdin. Point command at your coding agent; keep
# {{machinist.model}} as a complete --flag={{machinist.model}} argument to
# expose model aliases.
[executors.omp]
command = ["/usr/local/lib/machinist-factory/omp-glm-pr"]
# models = { default = "<your-model>" }

# Register every repository a managed worker may use. Paths are instance
# values, so put them in worker.local.toml, not here.
# [repositories.my-project]
# path = "/absolute/path/to/my-project"