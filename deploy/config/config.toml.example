# Machinist control-plane configuration template.
#
# The installer copies this file to /etc/machinist/config.toml only when that
# file does not exist; it never overwrites an existing config, the local
# overlay or the env files. Put instance values (hosts, ports, paths, project
# names, repository mappings) in /etc/machinist/config.local.toml, which is
# merged on top of this file at load time (base first, overlay second, the
# overlay wins; tables merge key by key, every other value is replaced).
# Secrets never belong in either file: they come from the systemd
# EnvironmentFile files under /etc/machinist/ (see ../systemd/).

[server]
listen = "127.0.0.1:7331"
database = "~/.machinist/server/machinist.db"
worker_token_file = "~/.machinist/server/worker.token"
max_concurrent_jobs = 1
# API authentication. "tokens" (default) requires scoped bearer tokens for
# machine clients; "none" opts out and is only allowed on a loopback or
# trusted Tailscale interface.
# auth = "tokens"

# Library profile used when a repository has no .machinist/review.yaml and no
# per-project choice in Settings. Falls back to the shipped `default` profile.
# [review]
# default_profile = "default"

# Pending failure-alert spool (MACH-25, MACH-70). Machinist spools one
# fail-<run>.json per failed or timed-out run that self-healing does not fix,
# optional healing-<run>.json retry notices, and endpoint health alerts here
# for the external Factory Alerts watcher. Without this section failures
# alert nowhere.
[alerts]
directory = "~/.machinist/alerts/pending"
# Optional webhook: every spooled alert is POSTed here so the watcher can wake
# on push instead of polling. The secret is read from an env var or a file and
# sent in the header; it is never logged. A webhook failure is logged and
# never fails the run.
#webhook_url = ""
#webhook_header = "X-Machinist-Alert-Token"
#webhook_secret_env = "MACHINIST_ALERT_WEBHOOK_SECRET"
#webhook_secret_file = ""
# Also spool a healing-<run>.json when self-healing requeues a job or
# schedules a backoff retry. Off by default: a retry is not a human alert.
#healing_alerts = false

# Take a task or issue to a reviewed pull request. With no prompt_file the
# submitted prompt is passed through; point it at a prompt template (resolved
# relative to this file) to wrap the task instead.
[commands.task-to-pr]
executor = "omp"
timeout = "120m"
# prompt_file = "prompts/task-to-pr.md"

# Map Machinist repository names to GitHub owner/name for PR links and intake.
# [github.repositories]
# my-project = "owner/my-project"

# Self-healing (MACH-25): on failure Machinist classifies the cause (infra,
# stale checkout, test failure, spec problem, secret guard) and requeues
# within a per-ticket retry budget; exhausted budgets move the Plane ticket
# to Needs attention. diagnose_command optionally runs omp (low effort) with
# the run transcript on stdin; without it a keyword classifier is used.
# [healing]
# max_retries = 2
# [healing.max_retries_per_project]
# MACH = 3
# diagnose_command = ["/usr/local/lib/machinist-factory/omp-glm", "low"]
# backoff = "5m"

# Endpoint health checks (MACH-25): alert when an endpoint is unreachable.
# Alerts land in the [alerts] directory.
# [health]
# every = "1m"
# timeout = "10s"
# [health.endpoints]
# glm = "https://api.example-glm-host/v1/models"
# sparks = "https://sparks.internal/healthz"
# pipsqueek = "https://pipsqueek.internal/healthz"

# Per-project auto-merge + deploy policy (MACH-24). Seeds ship with MACH
# (OhMyMachinist: rebuild + restart the control plane) and SPARK (sparkDash on
# spark2) on; every other project is off until configured. An entry replaces
# the seed for that project; the Settings UI writes the same shapes into the
# "plane.merge_policies" / "plane.merge_policy.<PROJECT>" settings, which are
# layered on top of this file.
# [plane.merge_policies.MYPROJECT]
# auto_merge = true
# merge_method = "squash"          # squash (default) | merge | rebase
# deploy_command = "./deploy.sh"
# rollback_command = "./rollback.sh"
# deploy_timeout = "15m"
# [plane.merge_policies.MYPROJECT.health_check]
# command = "curl -fsS http://127.0.0.1:8080/healthz"   # or url = …
# url = "http://10.0.0.5:5555/"
# status = 200                     # URL checks; default 200
# expect = "healthy"               # substring; {sha} becomes the merge SHA
